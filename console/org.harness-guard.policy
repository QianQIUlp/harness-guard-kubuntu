<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- pkexec /usr/sbin/harness-guard-apply and /usr/sbin/harness-guard-setup, run by
     harness-guard-console. Admin password every time (auth_admin, not
     auth_admin_keep), and only in the active local session. The guards deny pkexec,
     so no agent reaches these. -->
<policyconfig>
  <action id="org.harness-guard.apply">
    <description>Apply the coding agents' guard policy</description>
    <message>Authentication is required to change what the coding agents may access</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/harness-guard-apply</annotate>
  </action>
  <action id="org.harness-guard.setup">
    <description>Guard or release a coding agent</description>
    <message>Authentication is required to guard or release a coding agent</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/harness-guard-setup</annotate>
  </action>
</policyconfig>
