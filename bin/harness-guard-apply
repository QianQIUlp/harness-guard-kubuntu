#!/usr/bin/python3 -I
"""Compile the owner's policy into AppArmor rules and apply them to running agents.

  sudo harness-guard-apply            compile /etc/harness-guard/policy.toml, check, load
  harness-guard-apply --print [FILE]  only print the rules a policy compiles to (- reads stdin)
  harness-guard-apply --replace SHA256
                                      as root: install the policy read from stdin, then
                                      apply it; refused unless the current policy.toml
                                      has that SHA-256 (the console runs this via pkexec)

Installed as /usr/sbin/harness-guard-apply. Each agent's rules go to
/etc/apparmor.d/harness-guard/ID, which its profile includes. Replacing a loaded
profile switches running processes to the new rules, so no restart is needed.
"""
import difflib
import hashlib
import os
import re
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

ETC = Path('/etc/harness-guard')
OWNER = tomllib.loads((ETC / 'owner.toml').read_text())
USER, HOME, UID = OWNER['user'], OWNER['home'], int(OWNER['uid'])
APPARMOR = Path('/etc/apparmor.d')
OUT = APPARMOR / 'harness-guard'
# The profiles name the owner through these variables, so nothing in them is one user's.
TUNABLES = APPARMOR / 'tunables' / 'harness-guard'
PARSER = '/usr/sbin/apparmor_parser'
RECEIPTS = Path('/var/lib/harness-guard/receipts')
# Profiles that attach to the vendor's own binary. A released agent must run as the
# vendor shipped it, so its profile attaches there only while one of the listed agents
# is guarded (has a receipt); otherwise to a path that never exists. Claude Desktop's
# guard can write Claude Code's versions/, so they stay attached while Desktop is
# guarded: a released Claude Code then still runs confined, never a guard-written binary
# unconfined. The other profiles attach to paths that exist only while guarded
# (claude-desktop.real, guard-bin/agy).
ATTACH = {'claude-code': (f'{HOME}/.local/share/claude/versions/*', ('claude-code', 'claude-desktop')),
          'antigravity': ('/opt/antigravity/antigravity', ('antigravity',))}

ACCESS = {'r': 'r', 'rx': 'rmix', 'rw': 'rwk', 'rwx': 'rwkmix'}
# Only these hold the owner's files; write grants elsewhere are refused.
OWNED = (f'{HOME}/', f'/run/media/{USER}/', f'/media/{USER}/')
# Unguarded programs run or read config from these, so no agent may write them.
# Keys, wallets and browser profiles are also denied in abstractions/harness-guard.
PROTECTED = tuple(f'{HOME}/{p}' for p in (
    '.bashrc', '.bash_profile', '.bash_login', '.bash_logout', '.profile', '.bash_aliases',
    '.pam_environment', '.xprofile', '.xsessionrc', '.gitconfig', '.git-credentials',
    '.ssh/', '.gnupg/', '.mozilla/', '.local/bin/', '.local/share/applications/',
    '.local/share/kservices6/', '.local/share/dbus-1/', '.local/share/systemd/',
    '.config/autostart/', '.config/systemd/', '.config/environment.d/', '.config/git/',
    '.config/gh/', '.config/plasma-workspace/', '.config/kdedefaults/', '.config/fish/',
    '.config/google-chrome/', '.config/chromium/', '.config/BraveSoftware/',
    '.config/microsoft-edge/', '.nvm/', '.cargo/', '.rustup/', '.npmrc', '.config/pnpm/',
    '.agents/',  # skills shared with other agents, which may run unguarded
))


class PolicyError(Exception):
    pass


def tunables_text():
    """AppArmor variables for the owner in owner.toml, which the profiles include."""
    if not (re.fullmatch(r'[a-z_][a-z0-9_-]*', USER) and re.fullmatch(r'/[A-Za-z0-9._+/-]+', HOME)
            and 0 < UID < 2**31):
        raise PolicyError(f'{ETC}/owner.toml: user must be a plain name, uid a number, and home a '
                          'plain absolute path (letters, digits and ._+-/ only)')
    text = (f'# Generated by harness-guard-apply from {ETC}/owner.toml and {RECEIPTS}. Do not edit.\n'
            f'@{{HG_USER}}={USER}\n@{{HG_UID}}={UID}\n@{{HG_HOME}}={HOME}\n')
    for agent, (path, guarded_by) in ATTACH.items():
        if not any(RECEIPTS.joinpath(f'{a}.json').exists() for a in guarded_by):
            path = f'/usr/libexec/harness-guard/released/{agent}'
        text += f'@{{HG_ATTACH_{agent.upper().replace("-", "_")}}}={path}\n'
    return text


def covers(a, b):
    """True if path a includes path b (directories end in /)."""
    return a == b or (a.endswith('/') and b.startswith(a))


def resolve(raw):
    """Normalized absolute path; directories end in /."""
    path = HOME + raw[1:] if raw.startswith('~/') else raw
    if not path.startswith('/') or re.search(r'[\x00-\x1f*?\[\]{}^"#,\\]|@\{|//|/\.\.?(/|$)', path):
        raise PolicyError(f'{raw}: use a plain absolute or ~/ path, without globs or quotes')
    directory = path.endswith('/') or os.path.isdir(path)
    path = path.rstrip('/') + ('/' if directory else '')
    if os.path.realpath(path) != (path.rstrip('/') or '/'):  # AppArmor matches the resolved path
        raise PolicyError(f'{raw}: is or goes through a symlink; use the real path {os.path.realpath(path)}')
    return path


def rules(entry):
    if not isinstance(entry, dict) or set(entry) != {'path', 'access'}:
        raise PolicyError(f'{entry}: each path needs exactly path and access')
    path, access = resolve(str(entry['path'])), entry['access']
    targets = [path, path + '**'] if path.endswith('/') else [path]
    if access == 'none':
        return path, [f'  audit deny "{t}" rwklmx,' for t in targets]
    if access not in ACCESS:
        raise PolicyError(f'{path}: access must be none, r, rx, rw or rwx, not {access!r}')
    if covers(path, f'{HOME}/'):
        raise PolicyError(f'{path}: covers your whole home folder; grant subfolders instead')
    owned = any(covers(root, path) for root in OWNED)
    if 'w' in access:
        if not owned:
            raise PolicyError(f'{path}: write access only inside {", ".join(OWNED)}')
        if hit := next((p for p in PROTECTED if covers(path, p) or covers(p, path)), None):
            raise PolicyError(f'{path}: write access would include {hit}, which unguarded programs use')
    owner = 'owner ' if owned else ''
    perms = [ACCESS[access]] * len(targets)
    if path.endswith('/'):
        perms[0] = 'r'  # the directory itself: list it, but never replace it
    return path, [f'  {owner}"{t}" {p},' for t, p in zip(targets, perms)]


def compile_policy(policy, agents):
    """Rule text per agent id; raises PolicyError listing every problem."""
    sections = policy.get('agents', {})
    errors = [f'unknown agent {a!r} (no {ETC}/agents/{a}.toml)' for a in sections if a not in agents]
    out = {}
    for agent in sorted(agents):
        section = sections.get(agent, {})
        errors += [f'{agent}: unknown setting {k!r}' for k in section if k not in ('paths', 'github_token')]
        lines, seen = [f'# Generated by harness-guard-apply from {ETC}/policy.toml. Do not edit.'], set()
        for entry in section.get('paths', []):
            try:
                path, text = rules(entry)
            except PolicyError as error:
                errors.append(f'{agent}: {error}')
                continue
            if path in seen:
                errors.append(f'{agent}: {path} is listed twice')
            seen.add(path)
            lines += text
        if agent == 'claude-desktop' and not RECEIPTS.joinpath('claude-code.json').exists():
            # Desktop has no private ~/.local/bin, so its guard reaches the real one. With
            # Claude Code not guarded, ~/.local/bin/claude is your own command: never
            # writable from a guard (also not by the CLI that Desktop starts).
            lines += ['  # Claude Code is not guarded: ~/.local/bin/claude is yours.',
                      '  audit deny @{HG_HOME}/.local/bin/claude{,.tmp.*} wl,']
        out[agent] = '\n'.join(lines) + '\n'
    if errors:
        raise PolicyError('\n'.join(errors))
    return out


def load(text):
    agents = {p.stem: tomllib.loads(p.read_text()) for p in (ETC / 'agents').glob('*.toml')}
    return compile_policy(tomllib.loads(text), agents), agents


def write_file(path, text):
    new = path.with_name(f'.{path.name}.new')
    new.write_text(text)
    new.chmod(0o644)
    new.replace(path)


def apply(replace=None):
    """Load the installed policy, or (expected SHA-256, text) to install a new one first."""
    policy_file = ETC / 'policy.toml'
    st = policy_file.stat()
    if st.st_uid != 0 or st.st_mode & 0o022:
        raise PolicyError(f'{policy_file} must be owned by root and writable only by root')
    current = policy_file.read_bytes()
    if replace and hashlib.sha256(current).hexdigest() != replace[0]:
        raise PolicyError(f'{policy_file} changed since it was read; reload and try again')
    compiled, agents = load(replace[1] if replace else current.decode())
    profiles = [APPARMOR / agents[a]['profile'] for a in compiled]
    tunables = tunables_text()
    for agent, text in compiled.items():
        old = (OUT / agent).read_text() if (OUT / agent).exists() else ''
        sys.stdout.writelines(difflib.unified_diff(old.splitlines(True), text.splitlines(True),
                                                   f'old/{agent}', f'new/{agent}'))
    with tempfile.TemporaryDirectory() as tmp:
        (Path(tmp) / 'harness-guard').mkdir()
        (Path(tmp) / 'tunables').mkdir()
        (Path(tmp) / 'tunables' / 'harness-guard').write_text(tunables)
        for agent, text in compiled.items():
            (Path(tmp) / 'harness-guard' / agent).write_text(text)
        for profile in profiles:  # the new rules must parse with every profile before any is loaded
            subprocess.run([PARSER, '-Q', '-K', '-I', tmp, '-I', str(APPARMOR), str(profile)], check=True)
    if replace:  # checked above; keep the previous policy next to it
        for path, data in ((policy_file.with_suffix('.toml.bak'), current),
                           (policy_file, replace[1].encode())):
            new = ETC / '.policy.toml.new'
            new.write_bytes(data)
            new.chmod(0o644)
            new.replace(path)
    write_file(TUNABLES, tunables)
    OUT.mkdir(mode=0o755, exist_ok=True)
    for agent, text in compiled.items():
        new = OUT / f'.{agent}.new'
        new.write_text(text)
        new.chmod(0o644)
        new.replace(OUT / agent)
    for stale in set(p.name for p in OUT.iterdir()) - set(compiled):
        (OUT / stale).unlink()
    subprocess.run([PARSER, '-r', '-W', *map(str, profiles)], check=True)
    print(f'Applied to running agents: {", ".join(compiled)}')


def main():
    args = sys.argv[1:]
    if args[:1] == ['--print'] and len(args) <= 2:
        source = args[1] if len(args) == 2 else ETC / 'policy.toml'
        compiled, _ = load(sys.stdin.read() if source == '-' else Path(source).read_text())
        for agent, text in compiled.items():
            print(f'== {agent}\n{text}')
    elif not args and os.geteuid() == 0:
        apply()
    elif (len(args) == 2 and args[0] == '--replace' and re.fullmatch('[0-9a-f]{64}', args[1])
          and os.geteuid() == 0):
        text = sys.stdin.read(1 << 20)
        if sys.stdin.read(1):
            raise PolicyError('the new policy is larger than 1 MiB')
        apply((args[1], text))
    else:
        sys.exit(__doc__.split('\n\n')[1])


if __name__ == '__main__':
    try:
        main()
    except (OSError, PolicyError, tomllib.TOMLDecodeError) as error:
        sys.exit(f'harness-guard-apply: {error}')
    except subprocess.CalledProcessError:
        sys.exit('harness-guard-apply: apparmor_parser failed (see above)')
