#!/usr/bin/python3 -I
"""Start Claude Code or Claude Desktop inside its AppArmor guard.

Installed as /usr/local/libexec/claude-guard and reached through root-owned
forwarders: ~/.local/bin/claude (CLI) and /usr/lib/claude-desktop/claude-desktop
(Desktop, passes --desktop). Fails closed if the profile is missing or not enforcing.
"""
import ctypes
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path('/home/qiu')
UID = 1000
NODE = HOME / '.nvm/versions/node/v22.23.2'
GUARD_BIN = '/usr/local/libexec/claude-guard-bin'
CACHE = HOME / '.cache/claude-guard'
TMP = Path(f'/tmp/claude-{UID}')
GUARDS = ('claude-code-guard', 'claude-desktop-guard')

# Writable private directory bind-mounted over ~/.local/bin inside the namespace,
# so the vendor updater works while the host entry stays root-owned.
CLI_VIEW = (HOME / '.local/state/claude/guard-bin', HOME / '.local/bin')
VERSIONS = HOME / '.local/share/claude/versions'
DESKTOP = '/usr/lib/claude-desktop/claude-desktop.real'

KEEP = ('TERM', 'COLORTERM', 'LANG', 'LC_ALL', 'LC_CTYPE', 'NO_COLOR',
        'GH_TOKEN', 'GITHUB_TOKEN', 'GH_HOST',
        'http_proxy', 'https_proxy', 'all_proxy', 'no_proxy',
        'HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'NO_PROXY')
KEEP_DESKTOP = ('WAYLAND_DISPLAY', 'XDG_ACTIVATION_TOKEN', 'DESKTOP_STARTUP_ID')

libc = ctypes.CDLL(None, use_errno=True)
MS_NOSUID, MS_NOEXEC, MS_BIND = 2, 8, 4096


def label():
    return Path('/proc/self/attr/current').read_text().strip()


def environment(desktop):
    """Allowlisted environment: secrets such as cloud keys or SSH_AUTH_SOCK are dropped."""
    env = {k: v for k, v in os.environ.items() if k in KEEP + (KEEP_DESKTOP if desktop else ())}
    env.update({
        'HOME': str(HOME), 'USER': 'qiu', 'LOGNAME': 'qiu',
        'PATH': f'{GUARD_BIN}:{NODE}/bin:{HOME}/.cargo/bin:{HOME}/.local/bin:/usr/bin:/bin',
        'BROWSER': f'{GUARD_BIN}/xdg-open',
        'XDG_RUNTIME_DIR': f'/run/user/{UID}',
        'DBUS_SESSION_BUS_ADDRESS': f'unix:path=/run/user/{UID}/bus',
        'TMPDIR': str(TMP),
        # Caches the guard can write must not be ones that unguarded tools execute from.
        'XDG_CACHE_HOME': str(CACHE),
        'NPM_CONFIG_CACHE': f'{CACHE}/npm',
        'COREPACK_HOME': f'{CACHE}/corepack',
        'PNPM_HOME': f'{CACHE}/pnpm',
        'CARGO_HOME': f'{CACHE}/cargo',
        'RUSTUP_HOME': f'{HOME}/.rustup',
        'HISTFILE': f'{CACHE}/bash_history',
        # GitHub works through GH_TOKEN; the real ~/.config/gh stays out of reach.
        'GH_CONFIG_DIR': f'{CACHE}/gh',
        'GIT_CONFIG_GLOBAL': '/etc/claude-guard/gitconfig',
        'GIT_CONFIG_NOSYSTEM': '1',
        'GIT_TERMINAL_PROMPT': '0',
    })
    if desktop:
        env.update({
            'XDG_SESSION_TYPE': 'wayland', 'XDG_CURRENT_DESKTOP': 'KDE', 'KDE_SESSION_VERSION': '6',
            # Window buttons come from compiled defaults, not the user's dconf.
            'GSETTINGS_BACKEND': 'memory',
            'GSETTINGS_SCHEMA_DIR': '/etc/claude-guard/gtk-schemas',
            'GTK_USE_PORTAL': '1',
            'PULSE_SERVER': f'unix:/run/user/{UID}/pulse/native',
            'PULSE_COOKIE': f'{CACHE}/pulse-cookie',
        })
    if not (env.get('GH_TOKEN') or env.get('GITHUB_TOKEN')):
        # The token lives in the keyring, which the guard cannot reach.
        try:
            token = subprocess.run(['/usr/bin/gh', 'auth', 'token', '--hostname', 'github.com'],
                                   env={**env, 'GH_CONFIG_DIR': f'{HOME}/.config/gh'},
                                   capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            token = ''
        if token:
            env['GH_TOKEN'] = token
    return env


def confine(profile):
    with open('/proc/self/attr/current', 'w') as f:
        f.write('changeprofile ' + profile)  # fails if the profile is not loaded
    if label() != profile + ' (enforce)':
        raise RuntimeError(f'{profile} is not enforcing; refusing to start')
    if libc.prctl(38, 1, 0, 0, 0) != 0:  # PR_SET_NO_NEW_PRIVS: setuid binaries stay powerless
        raise OSError(ctypes.get_errno(), 'PR_SET_NO_NEW_PRIVS failed')


def mount(source, target, fstype=None, flags=0, data=None):
    if libc.mount(source, str(target).encode(), fstype, flags, data) != 0:
        raise OSError(ctypes.get_errno(), f'cannot mount {source.decode()} on {target}')


def namespace(binds=()):
    """Private mount namespace with its own /dev/pts, so the user's other terminals
    (and the keystrokes typed into them) do not exist inside the guard."""
    os.unshare(os.CLONE_NEWUSER | os.CLONE_NEWNS)
    for name, value in (('setgroups', 'deny'), ('uid_map', f'{UID} {UID} 1'), ('gid_map', f'{UID} {UID} 1')):
        Path('/proc/self', name).write_text(value)
    mount(b'devpts', '/dev/pts', b'devpts', MS_NOSUID | MS_NOEXEC, b'newinstance,ptmxmode=0666,mode=0620')
    for source, target in binds:
        mount(bytes(source), target, flags=MS_BIND)
    # The namespace UID is not 0, so exec drops the namespace capabilities.


def main():
    desktop = sys.argv[1:2] == ['--desktop']
    args = sys.argv[2:] if desktop else sys.argv[1:]
    if os.getuid() != UID:
        raise RuntimeError('run as qiu')
    if label() in (g + ' (enforce)' for g in GUARDS):
        env = dict(os.environ)  # already guarded (e.g. Desktop starting the CLI): keep SDK IPC
    else:
        env = environment(desktop)
        os.closerange(3, 1 << 20)  # descriptors opened unconfined would bypass revalidation
        confine(GUARDS[desktop])
    for directory in (CACHE, TMP, CLI_VIEW[0]):
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)

    if desktop:
        namespace()
        os.execve(DESKTOP, [DESKTOP, *args, '--ozone-platform=wayland',
                            '--disable-dev-shm-usage', '--password-store=kwallet6'], env)

    link = CLI_VIEW[0] / 'claude'
    if not link.exists():  # first run, or the selected version was removed
        link.unlink(missing_ok=True)
        versions = [p for p in VERSIONS.iterdir() if re.fullmatch(r'\d+\.\d+\.\d+', p.name)]
        if not versions:
            raise RuntimeError(f'no Claude Code version in {VERSIONS}')
        link.symlink_to(max(versions, key=lambda p: tuple(map(int, p.name.split('.')))))
    namespace([CLI_VIEW])
    os.execve(CLI_VIEW[1] / 'claude', ['claude', *args], env)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError) as error:
        sys.exit(f'claude-guard: {error}')
