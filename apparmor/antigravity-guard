# Guard for the Antigravity app. /usr/local/bin/antigravity and the desktop entry go
# through the launcher (harness-guard-setup guard antigravity) (see agents/antigravity.toml).
# While the app is guarded the profile also attaches to the app binary, so running it
# directly is still confined; once released it attaches to nothing
# (@{HG_ATTACH_ANTIGRAVITY}, set by harness-guard-apply). /opt/antigravity belongs to the owner
# but stays read-only here: the app's updater is inactive for this install, and new
# versions are installed outside the guard.
abi <abi/5.0>,
include <tunables/global>
include <tunables/harness-guard>

profile antigravity-guard @{HG_ATTACH_ANTIGRAVITY} flags=(attach_disconnected) {
  include <abstractions/harness-guard>
  include <abstractions/harness-guard-antigravity>
  include if exists <harness-guard/antigravity>
  include <abstractions/harness-guard-electron>

  /opt/antigravity/ r,
  /opt/antigravity/** rm,
  /opt/antigravity/{antigravity,chrome_crashpad_handler} ix,
  /opt/antigravity/resources/bin/{language_server,webm_encoder} ix,

  # Electron settings and caches; bin/agy-node runs the app as Node for MCP servers.
  owner @{HG_HOME}/.config/Antigravity/ rw,
  owner @{HG_HOME}/.config/Antigravity/** rwkmix,
  # The language server: conversations, browser recordings and its login file. It asks
  # the Secret Service first on every start, is refused and falls back to the file, so
  # the refusal is not logged.
  deny dbus send bus=session peer=(name=org.freedesktop.secrets),
  owner @{HG_HOME}/.gemini/antigravity/ rw,
  owner @{HG_HOME}/.gemini/antigravity/** rwkmix,
  # The OpenTelemetry thread tries to lock its own /proc files every minute; the lock
  # does nothing for /proc, so it is refused without logging.
  deny owner /proc/@{pid}/{,task/@{tid}/}{stat,status,cmdline} k,
  owner @{HG_HOME}/.cache/antigravity-guard/{,**} rwkmix,
  owner @{HG_HOME}/.cache/antigravity-guard/** l,
  owner /tmp/antigravity-@{HG_UID}/{,**} rwkmix,
}
