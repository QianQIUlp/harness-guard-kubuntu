# Claude's own state, shared by claude-code-guard and claude-desktop-guard
# (Desktop runs Claude Code sessions).

  owner @{HG_HOME}/.claude/ rw,
  owner @{HG_HOME}/.claude/** rwkmix,
  owner @{HG_HOME}/.claude.json{,.*} rwk,
  owner @{HG_HOME}/.claude.json.lock/{,**} rwk,
  owner @{HG_HOME}/.cache/claude-guard/{,**} rwkmix,
  owner /tmp/claude-@{HG_UID}/{,**} rwkmix,

  # Claude Code native installs and updates. Binaries in versions/ are attached to
  # claude-code-guard, so writing them cannot create an unconfined program.
  owner @{HG_HOME}/.local/share/claude/versions/ rw,
  owner @{HG_HOME}/.local/share/claude/versions/** rwkmix,
  owner @{HG_HOME}/.local/state/claude/{,**} rwk,
  owner @{HG_HOME}/.local/bin/ r,
  # Inside the launcher's private view this is ~/.local/state/claude/guard-bin; the
  # host file is a root-owned, immutable forwarder.
  owner @{HG_HOME}/.local/bin/claude{,.tmp.*} rw,
  @{HG_HOME}/.local/bin/claude rix,
  mount options in (rw,bind,silent) @{HG_HOME}/.local/state/claude/guard-bin/ -> @{HG_HOME}/.local/bin/,

  # agy as a subagent: ~/.local/bin/agy (a root-owned forwarder, also in the private
  # view) runs the launcher, which hands the request to harness-guard-handoff. agy runs
  # in agy-guard; its files and login stay unreadable here.
  @{HG_HOME}/.local/bin/agy rix,
  owner /run/user/@{HG_UID}/harness-guard-handoff.sock rw,
