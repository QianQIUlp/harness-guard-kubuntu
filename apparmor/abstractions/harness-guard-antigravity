# Antigravity settings shared by the app and agy: plugins, skills, MCP servers and
# projects. Each guard adds its own folder (logins, conversations) and its Secret
# Service rule. KWallet stays denied, and attempts are logged.

  owner @{HG_HOME}/.gemini/ r,
  owner @{HG_HOME}/.gemini/config/ rw,
  owner @{HG_HOME}/.gemini/config/** rwkmix,

  audit deny dbus send bus=session peer=(name=org.kde.kwalletd6),
