# Development programs inherit the guard; executable access grants no file writes.
    /usr/** rmix,
    /etc/{bash.bashrc,profile} r,
    /etc/profile.d/{,**} r,
    /etc/java-*/{,**} r,
    /etc/manpath.config r,
    /etc/default/im-config r,
    /proc/sys/kernel/random/uuid r,
    /sys/fs/cgroup/{,**} r,
    owner /home/qiu/.{bashrc,bash_profile,bash_login,profile,bash_aliases} r,
    owner /home/qiu/.grok/completions/bash/grok.bash r,
    owner /home/qiu/.npmrc r,
    owner /home/qiu/.config/pnpm/ r,
    owner /home/qiu/.config/pnpm/auth.ini r,

    owner /home/qiu/.nvm/ r,
    owner /home/qiu/.nvm/{nvm.sh,bash_completion} r,
    owner /home/qiu/.nvm/nvm-exec rix,
    owner /home/qiu/.nvm/alias/{,**} r,
    owner /home/qiu/.nvm/versions/{,node/} r,
    owner @{CLAUDE_NODE}/{,**} rmix,
    owner /home/qiu/.cache/node/ r,
    owner /home/qiu/.cache/node/corepack/{,**} rwkmix,

    owner /home/qiu/.cargo/ r,
    owner /home/qiu/.cargo/{env,config,config.toml} r,
    owner /home/qiu/.cargo/bin/{,**} rmix,
    owner /home/qiu/.rustup/{,**} rmix,
    owner /home/qiu/.rustup/settings.toml rk,

    # GitHub credentials were explicitly accepted; other credential stores stay isolated.
    owner /home/qiu/.config/gh/{,**} rwk,

    # forkpty opens the root-owned multiplexer before creating a user-owned slave.
    /dev/pts/ r,
    /dev/{ptmx,pts/ptmx} rw,
