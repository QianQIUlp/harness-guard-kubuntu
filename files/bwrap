#!/usr/bin/python3 -I
"""Use Glycin 2.1's existing fallback; other bwrap calls use the native binary."""
import os
import sys

args = sys.argv[1:]
# Glycin has no environment switch for SandboxSelector in this installed version.
# Refuse only its sandbox template, so its availability check uses the outer guard.
if '--seccomp' in args and '/tmp-home' in args and '/tmp-run' in args:
    print('bwrap: No permissions to create a new namespace for Glycin; '
          'the enclosing Claude AppArmor guard remains active.', file=sys.stderr)
    raise SystemExit(1)
os.execve('/usr/bin/bwrap', ['bwrap', *args], dict(os.environ))
